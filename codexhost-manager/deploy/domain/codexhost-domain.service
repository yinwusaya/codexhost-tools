[Unit]
Description=Private HTTPS domain gateway for CodexHost Manager
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=notify
User=root
Group=root
Environment=XDG_DATA_HOME=/var/lib/codexhost-domain
Environment=XDG_CONFIG_HOME=/var/lib/codexhost-domain/config
StateDirectory=codexhost-domain
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/caddy run --config /etc/codexhost-domain/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --address 127.0.0.1:2020 --config /etc/codexhost-domain/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
